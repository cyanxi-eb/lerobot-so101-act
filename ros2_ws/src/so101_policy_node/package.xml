<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_policy_node</name>
  <version>0.1.0</version>
  <description>
    Deployment skeleton for the ACT / language-conditioned SO-101 policies
    trained in this repository. Written for ROS2 Jazzy but never executed on
    the development machine (no ROS2 installation, no hardware).
  </description>
  <maintainer email="cyanxi-eb@users.noreply.github.com">cyanxi-eb</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
